% Every source the journey cites.
%
% Ordered in first-citation order across the pages, because the AMA style
% numbers by order of appearance and carry-back.qmd pulls the whole file in
% with nocite. That makes the complete list read in journey order rather than
% alphabetically. A new entry goes in under the section comment for the page
% that first cites it, at the point that page reaches it — not appended.
%
% Titles are wrapped in double braces so citeproc reproduces them exactly.
% Given names are initials only, matching the rest of the family.

% ── what breathing is doing ───────────────────────────────────────────
@article{russo17,
  author  = {Russo, M. A. and Santarelli, D. M. and O'Rourke, D.},
  title   = {{The physiological effects of slow breathing in the healthy human}},
  journal = {Breathe}, volume = {13}, number = {4}, pages = {298--309}, year = {2017},
  url     = {https://breathe.ersjournals.com/content/13/4/298}
}

% Not a paper, and it would be dishonest to dress it as one. The shape of the
% oxygen–haemoglobin dissociation curve is textbook physiology with no single
% modern source; it is kept as a pointer to a reference description so the
% citation resolves to something a reader can actually go and read.
@misc{dissociation,
  title        = {{The oxygen–haemoglobin dissociation curve, and the Bohr effect}},
  howpublished = {Standard respiratory physiology rather than a single source},
  url          = {https://en.wikipedia.org/wiki/Oxygen%E2%80%93hemoglobin_dissociation_curve}
}

@article{stocchetti05,
  author  = {Stocchetti, N. and Maas, A. I. and Chieregato, A. and van der Plas, A. A.},
  title   = {{Hyperventilation in head injury: a review}},
  journal = {Chest}, volume = {127}, number = {5}, pages = {1812--1827}, year = {2005},
  url     = {https://doi.org/10.1378/chest.127.5.1812}
}

